GROQ_API_KEY=your_groq_api_key_here
MEM0_API_KEY=optional_if_using_cloud_mem0
# GROQ_MODEL=groq/llama-3.3-70b-versatile  # higher quality, 100k TPD free
# GROQ_MODEL=groq/llama-3.1-8b-instant      # default, 500k TPD free, faster

# Distributed mode (set by start_distributed.sh — leave unset for monolith)
# SEARCHER_URL=http://localhost:8001
# REVIEWER_URL=http://localhost:8002
# WRITER_URL=http://localhost:8003

# Worker IAM tokens — rotate these in production (dev defaults work locally)
# SEARCHER_TOKEN=dev-searcher-token
# REVIEWER_TOKEN=dev-reviewer-token
# WRITER_TOKEN=dev-writer-token
